# 复制为 e2_notify.local.env（勿提交 git），填好后：
#   跑完通知: bash Control experiment/configs/start_e2_notify_watcher.sh
#   每日进度: bash Control experiment/configs/start_e2_daily_progress.sh
#   (SN 补跑 resume_e2_sn_v2.sh 在已配置邮件时会自动启每日进度)
#
# QQ 邮箱示例：SMTP 需用「授权码」，不是 QQ 密码
NOTIFY_TO=your_email@example.com
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=3464191986@qq.com
SMTP_PASS=your_smtp_authorization_code
